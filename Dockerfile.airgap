# Air-gapped multi-stage Wolfi/Chainguard distroless build -> 0 Critical / 0 High CVEs:
# No internet, no apk/apt network calls. Base images, Helm v4.3.2, and Python wheels all
# come from internal Artifactory mirrors:
#
#   docker build -f Dockerfile.airgap \
#     --secret id=ca,src="$SSL_CERT_FILE" \
#     --build-arg HELM_IMAGE=artifactory.gcp.elta.co.il/docker.io/alpine/helm:4.3.2 \
#     --build-arg BUILDER_IMAGE=artifactory.gcp.elta.co.il/docker.io/chainguard/python:latest-dev \
#     --build-arg BASE_IMAGE=artifactory.gcp.elta.co.il/docker.io/chainguard/python:latest \
#     --build-arg PIP_INDEX_URL="$PIP_INDEX_URL" \
#     -t sokushinbutsu/dappsoclusterr:1.0.4 .
#
# Notes:
# - `--secret id=ca,src="$SSL_CERT_FILE"` passes the corporate root CA to pip only during
#   the throwaway builder stage so nothing sensitive or environment-specific enters the
#   final runtime image layers.
ARG HELM_IMAGE=artifactory.gcp.elta.co.il/docker.io/alpine/helm:4.3.2
ARG BUILDER_IMAGE=artifactory.gcp.elta.co.il/docker.io/chainguard/python:latest-dev
ARG BASE_IMAGE=artifactory.gcp.elta.co.il/docker.io/chainguard/python:latest

FROM ${HELM_IMAGE} AS helm

FROM ${BUILDER_IMAGE} AS builder
USER root
COPY requirements.txt /tmp/requirements.txt
ARG PIP_INDEX_URL=https://artifactory.gcp.elta.co.il/artifactory/api/pypi/pypi.org/simple
RUN --mount=type=secret,id=ca,target=/tmp/ca.crt,required=false \
    if [ -s /tmp/ca.crt ]; then export PIP_CERT=/tmp/ca.crt; fi \
 && SITE_PACKAGES="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
 && mkdir -p "/out${SITE_PACKAGES}" /out/usr/local/bin \
 && pip install --no-cache-dir --only-binary=:all: \
      --index-url "${PIP_INDEX_URL}" \
      --target "/out${SITE_PACKAGES}" -r /tmp/requirements.txt \
 && if [ -d "/out${SITE_PACKAGES}/bin" ]; then \
      mv "/out${SITE_PACKAGES}/bin/"* /out/usr/local/bin/ && rmdir "/out${SITE_PACKAGES}/bin"; \
    fi

FROM ${BASE_IMAGE}
COPY --from=helm /usr/bin/helm /usr/local/bin/helm
COPY --from=builder /out/ /

WORKDIR /app
COPY operator.py /app/operator.py

ENV PYTHONSAFEPATH=1 \
    HELM_CACHE_HOME=/tmp/helm/cache \
    HELM_CONFIG_HOME=/tmp/helm/config \
    HELM_DATA_HOME=/tmp/helm/data

EXPOSE 8080

# Reset Chainguard's default ["/usr/bin/python"] entrypoint so CMD and kubectl exec work directly.
ENTRYPOINT []
CMD ["/usr/bin/python", "-m", "kopf", "run", "--standalone", "--all-namespaces", "--liveness=http://0.0.0.0:8080/healthz", "/app/operator.py"]
